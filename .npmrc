# The @deepseek-ai/* packages are provided by the DSH host at runtime and are
# declared as optional peers. npm would otherwise try to resolve the entire
# harness dependency graph over the network for no benefit.
legacy-peer-deps=true

# This link is slow and drops long-lived connections; be patient and retry.
fetch-retries=5
fetch-retry-mintimeout=5000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
