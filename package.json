{
  "name": "dsh-bloomglass",
  "version": "0.1.2",
  "description": "A DeepSeek Harness Web theme: ten OKLCH Morandi palettes that adapt to light and dark, plus an optional uploaded wallpaper rendered behind frosted glass panels. / 十套 OKLCH 莫兰迪配色，明暗自适应；可选上传壁纸铺满窗口、界面以磨砂玻璃叠上去。",
  "author": "dsh-bloomglass contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmoSail/dsh-bloomglass.git"
  },
  "homepage": "https://github.com/CosmoSail/dsh-bloomglass#readme",
  "bugs": {
    "url": "https://github.com/CosmoSail/dsh-bloomglass/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "docs/showcase/README.md",
    "docs/showcase/palette-board.png",
    "docs/showcase/ui-mist-light.png",
    "docs/showcase/ui-ripple-plain.png",
    "docs/showcase/ui-ripple-glass.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "bundle": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "showcase": "node scripts/generate-wallpaper.mjs && node scripts/generate-showcase.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "wallpaper",
    "frosted-glass",
    "glassmorphism",
    "oklch",
    "morandi",
    "bloom"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-settings": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-theme": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
